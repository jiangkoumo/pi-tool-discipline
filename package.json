{
  "name": "pi-tool-discipline",
  "version": "0.2.0",
  "description": "pi extension (prompt-level): enforce ffgrep/fffind-first search discipline and neutralize the default bash file-operation guideline",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangkoumo/pi-tool-discipline.git"
  },
  "homepage": "https://github.com/jiangkoumo/pi-tool-discipline",
  "bugs": {
    "url": "https://github.com/jiangkoumo/pi-tool-discipline/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "ffgrep",
    "fffind",
    "grep",
    "search",
    "discipline"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/jiangkoumo/pi-tool-discipline/master/assets/banner.png"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/strip.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
